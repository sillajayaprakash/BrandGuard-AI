# Supabase project URL and public anon/publishable key (never use a service-role key here).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key

# Local development origin. On Render, RENDER_EXTERNAL_HOSTNAME is detected automatically;
# set APP_ORIGIN when using a custom domain.
APP_ORIGIN=

GEMINI_API_KEY=your_key_here

